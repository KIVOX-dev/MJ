# Optional defaults. You can also enter both in the app (Settings) and nothing needs to be baked into the build.
# Backend URL, no trailing slash. Must be listed in the backend's CORS_ORIGINS for this site's origin.
VITE_API_URL=http://localhost:3000
# Must equal the backend's WEB_API_TOKEN. Anything in VITE_* is public in the built JS: prefer entering it in the app.
# VITE_API_TOKEN=
