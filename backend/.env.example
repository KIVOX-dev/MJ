# --- Server ---
NODE_ENV=development
# AppSail injects X_ZOHO_CATALYST_LISTEN_PORT; PORT is the local fallback.
PORT=3000
LOG_LEVEL=info
DEFAULT_TIMEZONE=Asia/Kolkata

# --- MongoDB Atlas ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/mj?retryWrites=true&w=majority

# --- Groq (https://console.groq.com) ---
# One or more keys, comma-separated (rotated on rate limits)
GROQ_API_KEYS=
# Primary model first, then fallbacks
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b

# Optional: override DNS resolvers if Atlas SRV lookup fails
# DNS_SERVERS=8.8.8.8,1.1.1.1

# --- WhatsApp Cloud API ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
OWNER_WHATSAPP_NUMBER=

# Comma-separated frontend origins (e.g. https://mj.vercel.app)
CORS_ORIGINS=
WHATSAPP_API_VERSION=v23.0

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_OWNER_ID=
PUBLIC_BASE_URL=

JOBS_SECRET=

# --- Newsdata.io ---
NEWSDATA_API_KEY=

NEWS_DIGEST_ENABLED=true
NEWS_DIGEST_TIME=08:00
NEWS_DIGEST_CHANNELS=telegram
NEWS_DIGEST_PREPARE_TIME=05:00
NEWS_ALERTS_ENABLED=true
NEWS_ALERT_INTERVAL_MIN=10
NEWS_ALERT_MAX_PER_DAY=30

# Models that can read images (must accept image input)
GROQ_VISION_MODELS=qwen/qwen3.8-27b

# Optional: self-hosted Crawlit (https://labs.arufian.dev/crawlit/). It has NO auth: keep it private (localhost or private network).
# CRAWLIT_URL=https://crawlit.your-domain.com   (a server must use https and a token; http only for localhost)
# CRAWLIT_TOKEN=

# Optional: email via Brevo (https://app.brevo.com/settings/keys/api). MJ can email ONLY OWNER_EMAIL.
# BREVO_SENDER_EMAIL must be a sender/domain you verified in Brevo.
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=
# BREVO_SENDER_NAME=MJ
# OWNER_EMAIL=

# Optional: mobile web app (frontend/). Min 16 chars; the app sends it as a Bearer token. Needs TELEGRAM_OWNER_ID.
# Also add the web app's origin to CORS_ORIGINS (e.g. https://your-app.vercel.app).
# WEB_API_TOKEN=

# Web Push for phone notifications (free). Generate once:  npx web-push generate-vapid-keys
# The private key must stay secret (never put it in the frontend). The subject falls back to mailto:OWNER_EMAIL.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Optional: language hint for voice transcription (en or ta). Unset = automatic. Setting it improves accuracy for accented speech.
# STT_LANGUAGE=en

# Picture generation engines (best first). With none set, a free no-key fallback is used. See docs/FEATURE-SETUP.md
# GEMINI_API_KEY=
# HF_TOKEN=            (free Hugging Face token: real FLUX.1 pictures from a free Space; uses your free daily GPU allowance)
# POLLINATIONS_API_KEY=

# Sarvam AI: human voices and accurate transcription for Indian English and Tamil (free plan works).
# One key, or several separated by commas (they are used in turn). Without it, Whisper and Microsoft voices are used.
# SARVAM_API_KEY=
# Your name: emails MJ writes for you are signed with it.
# OWNER_NAME=Kaviarasan M
# Models tried, in order, when MJ draws vector pictures with Groq (used when no photo engine is available).
# GROQ_IMAGE_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-120b
# Also use the free no-key Pollinations service for pictures (adds a watermark, about 1 picture / 45 s).
# IMAGE_USE_POLLINATIONS=false
