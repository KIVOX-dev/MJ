# Domain that points at this server (an A record to the server's IP). Caddy gets the HTTPS certificate for it.
CRAWLIT_DOMAIN=crawlit.example.com

# Shared secret MJ must send as "Authorization: Bearer <token>". Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# (or: openssl rand -hex 32). Put the SAME value in MJ's CRAWLIT_TOKEN.
CRAWLIT_TOKEN=

# Optional tuning (defaults are conservative for a 2 GB server)
# SEARCH_ENGINE=duckduckgo
# BROWSER_POOL_SIZE=2
# CRAWL_CONCURRENCY=5
# PROXY_URL=
